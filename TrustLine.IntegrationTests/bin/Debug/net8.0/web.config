<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\AnonymousComplaintsAPI.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />

      <!-- Configuration pour les gros fichiers -->
      <security>
        <requestFiltering>
          <!-- Augmenter la taille max des requêtes à 100MB -->
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>

  <!-- Configuration ASP.NET Core pour les gros fichiers -->
  <system.web>
    <!-- 100MB max request size -->
    <httpRuntime maxRequestLength="102400" executionTimeout="3600" />
  </system.web>
</configuration>
